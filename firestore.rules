rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isDriver() {
      return request.auth != null && request.auth.token.driver == true;
    }

    function validThankYou() {
      return request.resource.data.keys().hasOnly([
          'text',
          'category',
          'categoryEmoji',
          'messageShown',
          'mood',
          'moodEmoji',
          'createdAt'
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200
        && request.resource.data.category in [
          'encouragement', 'reminders', 'wishes', 'philosophy', 'unknown'
        ]
        && request.resource.data.categoryEmoji is string
        && request.resource.data.categoryEmoji.size() <= 8
        && request.resource.data.messageShown is string
        && request.resource.data.messageShown.size() <= 500
        && request.resource.data.mood in [
          'tired', 'okay', 'happy', 'chaos', 'unknown'
        ]
        && request.resource.data.moodEmoji is string
        && request.resource.data.moodEmoji.size() <= 8
        && request.resource.data.createdAt == request.time;
    }

    function validStats() {
      return request.resource.data.keys().hasOnly(['totalViews', 'totalThanks'])
        && request.resource.data.get('totalViews', 0) is int
        && request.resource.data.get('totalThanks', 0) is int
        && request.resource.data.get('totalViews', 0) >= 0
        && request.resource.data.get('totalThanks', 0) >= 0;
    }

    function validRelayCreate() {
      return request.resource.data.keys().hasOnly([
          'text',
          'category',
          'moment',
          'status',
          'createdAt'
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 140
        && request.resource.data.category in [
          'encouragement', 'reminders', 'wishes', 'philosophy', 'unknown'
        ]
        && request.resource.data.moment in [
          'early', 'daytime', 'commute', 'late'
        ]
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
    }

    function validRelayReview() {
      return resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'text',
          'category',
          'moment',
          'status',
          'createdAt',
          'reviewedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedAt == request.time;
    }

    match /thankyou_messages/{messageId} {
      allow create: if validThankYou();
      allow read, update, delete: if isDriver();
    }

    match /relay_messages/{messageId} {
      allow create: if validRelayCreate();
      allow read: if isDriver() || resource.data.status == 'approved';
      allow update: if isDriver() && validRelayReview();
      allow delete: if isDriver();
    }

    match /stats/global {
      allow read: if true;
      allow create: if validStats()
        && request.resource.data.get('totalViews', 0) <= 1
        && request.resource.data.get('totalThanks', 0) <= 1;
      allow update: if validStats()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['totalViews', 'totalThanks'])
        && request.resource.data.get('totalViews', 0)
          >= resource.data.get('totalViews', 0)
        && request.resource.data.get('totalViews', 0)
          <= resource.data.get('totalViews', 0) + 1
        && request.resource.data.get('totalThanks', 0)
          >= resource.data.get('totalThanks', 0)
        && request.resource.data.get('totalThanks', 0)
          <= resource.data.get('totalThanks', 0) + 1;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
